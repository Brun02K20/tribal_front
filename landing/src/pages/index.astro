---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ENCARGOS_URL, SHOP_URL, formatPrice, getShowcaseProducts } from '../lib/store';

const products = await getShowcaseProducts(8);
const heroProducts = products.slice(0, 3);
const hasHeroPhotos = heroProducts.length === 3;

const icons = {
	truck: '<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
	lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2"/>',
	hand: '<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M11 10.5V4a1.5 1.5 0 0 1 3 0v6.5"/><path d="M14 10.5V5.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-.6a6 6 0 0 1-4.6-2.2L2.6 15.9a1.5 1.5 0 0 1 2.2-2L8 16.5"/>',
	gem: '<path d="M6.5 4h11l3.5 5-9 11-9-11 3.5-5Z"/><path d="M3 9h18M9.5 4 8 9l4 11 4-11-1.5-5"/>',
};

const benefits = [
	{ icon: icons.gem, title: 'Piezas únicas', text: 'Diseños irrepetibles: cuando se van, no vuelven.' },
	{ icon: icons.hand, title: 'Hecho a mano', text: 'Piedras naturales, resina y alambre, trabajados uno a uno.' },
	{ icon: icons.truck, title: 'Envíos a todo el país', text: 'Con Correo Argentino, a domicilio o sucursal.' },
	{ icon: icons.lock, title: 'Pago seguro', text: 'Pagás con Mercado Pago, sin vueltas.' },
];

const testimonials = [
	{ quote: 'Compre decoraciones para mi casa y llegaron tal como se veian en la tienda. Hermoso todo.', author: 'Mariana, Cordoba' },
	{ quote: 'Pedi un regalo artesanal de ultimo momento y la atencion fue excelente. Volvere a comprar.', author: 'Lucas, Buenos Aires' },
	{ quote: 'La tienda tiene productos originales y faciles de encontrar. Muy buena experiencia de compra.', author: 'Sofia, Rosario' },
];

const heroSlots = ['slot-main', 'slot-round', 'slot-small'];
---

<Layout
	title="Tribal Trend | Joyería artesanal única, hecha a mano"
	description="Collares, pulseras, anillos y aros artesanales con piedras naturales. Piezas únicas hechas a mano en Argentina, con envíos a todo el país y pago seguro."
	keywords="joyería artesanal, bijouterie artesanal, collares artesanales, pulseras artesanales, piedras naturales, regalos originales, cordoba, argentina"
	canonicalPath="/"
>
	<Marquee />

	<header class="topbar">
		<nav class="nav" aria-label="Navegación principal">
			<a class="brand" href="#inicio">
				<img src="/icons/logo_tribal_trnasparente.png" alt="" width="52" height="52" />
				Tribal Trend
			</a>
			<div class="nav-links">
				<a href="#destacados">Piezas</a>
				<a href="#beneficios">Por qué elegirnos</a>
				<a href="/preguntas-frecuentes">FAQ</a>
				<a href="#contacto">Contacto</a>
			</div>
			<div class="nav-actions">
				<a class="app-btn-cta nav-cta" href={SHOP_URL}>Comprar ahora</a>
				<button
					id="landingMenuButton"
					type="button"
					class="app-btn-secondary nav-toggle"
					aria-expanded="false"
					aria-controls="landingMobileMenu"
				>
					Menú
				</button>
			</div>
		</nav>

		<nav id="landingMobileMenu" class="mobile-nav app-collapsible" data-open="false" aria-hidden="true" aria-label="Navegación móvil">
			<a href="#destacados">Piezas</a>
			<a href="#beneficios">Por qué elegirnos</a>
			<a href="/preguntas-frecuentes">Preguntas frecuentes</a>
			<a href="#contacto">Contacto</a>
			<a class="app-btn-cta" href={SHOP_URL}>Ir a la tienda</a>
		</nav>
	</header>

	<main class="app-shell">
		<section id="inicio" class="hero">
			<div class="hero-copy">
				<p class="kicker">Joyería artesanal · Hecha a mano en Argentina</p>
				<h1>Joyas únicas, <span>hechas a mano</span> para vos</h1>
				<p class="section-lead">
					Collares, pulseras, anillos y aros con piedras naturales. Cada pieza es irrepetible: cuando se va, no vuelve.
				</p>
				<div class="hero-cta">
					<a class="app-btn-cta" href={SHOP_URL}>Comprar ahora →</a>
					<a class="app-btn-outline" href={ENCARGOS_URL}>Encargá tu diseño</a>
				</div>
				<ul class="trust">
					{benefits.slice(1).map((benefit) => (
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={benefit.icon}></svg>
							{benefit.title}
						</li>
					))}
				</ul>
			</div>

			<div class="hero-visual">
				{hasHeroPhotos ? (
					<div class="collage">
						{heroProducts.map((product, index) => (
							<div class={`slot ${heroSlots[index]}`}>
								<a class={index === 1 ? 'round-frame' : 'arch'} href={product.href} aria-label={`Ver ${product.nombre}`}>
									<img src={product.image} alt={`${product.nombre} artesanal`} loading="eager" decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} />
								</a>
								<a class="price-tag" href={product.href} tabindex="-1">
									<span class="price-name">{product.nombre}</span>
									<strong>{formatPrice(product.price)}</strong>
								</a>
							</div>
						))}
						<div class="stamp" aria-hidden="true">
							<svg viewBox="0 0 100 100">
								<defs><path id="stamp-circle" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0" /></defs>
								<circle cx="50" cy="50" r="49" fill="#a8492a" />
								<text font-size="8.6" fill="#f8f3e7"><textPath href="#stamp-circle" textLength="224" lengthAdjust="spacing">HECHO A MANO ✦ PIEZAS ÚNICAS ✦</textPath></text>
							</svg>
							<span>✦</span>
						</div>
					</div>
				) : (
					<img
						src="/icons/logo_tribal_trnasparente.png"
						alt="Tribal Trend, joyería artesanal hecha a mano"
						class="hero-logo"
						width="720"
						height="720"
						fetchpriority="high"
						loading="eager"
						decoding="async"
					/>
				)}
			</div>
		</section>

		{products.length > 0 && (
			<section id="destacados" class="section">
				<div class="section-head">
					<div>
						<p class="kicker">Recién salidas del taller</p>
						<h2 class="section-title">Elegí la tuya antes que nadie</h2>
					</div>
					<a class="see-all" href={SHOP_URL}>Ver toda la colección →</a>
				</div>
				<div class="pieces">
					{products.map((product) => (
						<a class="piece" href={product.href}>
							<span class="piece-media">
								<img src={product.image} alt={`${product.nombre} artesanal`} loading="lazy" decoding="async" />
								{product.isUnique && <span class="badge">Pieza única</span>}
								<span class="piece-cta">Ver pieza →</span>
							</span>
							<span class="piece-name">{product.nombre}</span>
							<span class="piece-price">
								{product.isFromPrice && <small>Desde</small>}
								{formatPrice(product.price)}
							</span>
						</a>
					))}
				</div>
				<div class="center">
					<a class="app-btn-cta" href={SHOP_URL}>Ver toda la colección →</a>
				</div>
			</section>
		)}

		<section id="beneficios" class="section">
			<ul class="benefits">
				{benefits.map((benefit) => (
					<li>
						<span class="benefit-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={benefit.icon}></svg>
						</span>
						<h3>{benefit.title}</h3>
						<p>{benefit.text}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="section campaign encargos">
			<div>
				<p class="kicker">Encargos personalizados</p>
				<h2 class="section-title">Tu idea, convertida en una joya</h2>
				<p>Elegís la piedra, los colores y el estilo. La creamos a mano, solo para vos.</p>
			</div>
			<a class="app-btn-cta" href={ENCARGOS_URL}>Encargar mi pieza →</a>
		</section>

		<section id="testimonios" class="section">
			<p class="kicker">Opiniones</p>
			<h2 class="section-title">Lo que dicen de Tribal Trend</h2>
			<div class="testimonials-grid">
				{testimonials.map((testimonial) => (
					<blockquote class="app-panel testimonial">
						<p class="stars" aria-hidden="true">★★★★★</p>
						<p>"{testimonial.quote}"</p>
						<footer>- {testimonial.author}</footer>
					</blockquote>
				))}
			</div>
		</section>

		<section id="contacto" class="section contact-section app-panel">
			<div class="contact-copy">
				<p class="kicker">¿Dudas?</p>
				<h2 class="section-title">Te ayudamos a elegir</h2>
				<p class="section-lead">
					Escribinos por una pieza, un envío o un encargo y te respondemos a la brevedad.
				</p>
				<a class="app-btn-outline contact-shop" href={SHOP_URL}>O mirá la tienda →</a>
			</div>

			<form id="contactForm" class="contact-form">
				<label>
					Nombre
					<input class="app-input" type="text" name="nombre" autocomplete="name" required />
				</label>
				<label>
					Email
					<input class="app-input" type="email" name="email" autocomplete="email" required />
				</label>
				<label>
					Teléfono <small>(opcional)</small>
					<input class="app-input" type="tel" name="telefono" autocomplete="tel" />
				</label>
				<label>
					Mensaje
					<textarea class="app-input" name="mensaje" rows="4" required></textarea>
				</label>
				<button class="app-btn-cta" type="submit">Enviar consulta</button>
				<p id="formStatus" class="form-status" aria-live="polite"></p>
			</form>
		</section>
	</main>

	<SiteFooter />

	<a id="mobileCta" class="app-btn-cta mobile-cta" href={SHOP_URL} aria-hidden="true" tabindex="-1">Comprar ahora →</a>

	<script>
		const mobileMenu = document.getElementById('landingMobileMenu');
		const mobileMenuButton = document.getElementById('landingMenuButton');

		if (mobileMenu instanceof HTMLElement && mobileMenuButton instanceof HTMLButtonElement) {
			const closeMobileMenu = () => {
				mobileMenu.dataset.open = 'false';
				mobileMenu.setAttribute('aria-hidden', 'true');
				mobileMenuButton.setAttribute('aria-expanded', 'false');
			};

			mobileMenuButton.addEventListener('click', () => {
				const isOpen = mobileMenu.dataset.open === 'true';
				mobileMenu.dataset.open = isOpen ? 'false' : 'true';
				mobileMenu.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
				mobileMenuButton.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
			});

			mobileMenu.querySelectorAll('a').forEach((anchor) => {
				anchor.addEventListener('click', closeMobileMenu);
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					closeMobileMenu();
				}
			});
		}

		// El CTA fijo de mobile aparece recién cuando los botones del hero quedan fuera de pantalla.
		const mobileCta = document.getElementById('mobileCta');
		const heroCta = document.querySelector('.hero-cta');
		if (mobileCta instanceof HTMLElement && heroCta instanceof HTMLElement) {
			const syncMobileCta = () => {
				const visible = heroCta.getBoundingClientRect().bottom < 0;
				mobileCta.classList.toggle('is-visible', visible);
				mobileCta.setAttribute('aria-hidden', visible ? 'false' : 'true');
				mobileCta.tabIndex = visible ? 0 : -1;
			};
			syncMobileCta();
			window.addEventListener('scroll', syncMobileCta, { passive: true });
		}

		const form = document.getElementById('contactForm');
		const status = document.getElementById('formStatus');

		if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) {
			throw new Error('No se encontraron los elementos del formulario de contacto.');
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (!submitButton || !status) {
				return;
			}

			submitButton.setAttribute('disabled', 'true');
			status.textContent = 'Enviando...';

			const formData = new FormData(form);
			const payload = {
				nombre: String(formData.get('nombre') ?? ''),
				email: String(formData.get('email') ?? ''),
				telefono: String(formData.get('telefono') ?? ''),
				mensaje: String(formData.get('mensaje') ?? ''),
			};

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});

				const result = await response.json();
				if (!response.ok || !result.ok) {
					throw new Error(result.message ?? 'No se pudo enviar el mensaje.');
				}

				form.reset();
				status.textContent = 'Mensaje enviado. Te contactaremos pronto.';
			} catch (error) {
				status.textContent =
					error instanceof Error ? error.message : 'No se pudo enviar el mensaje en este momento.';
			} finally {
				submitButton.removeAttribute('disabled');
			}
		});
	</script>
</Layout>

<style>
	.topbar {
		backdrop-filter: blur(10px);
		background: rgba(248, 243, 231, 0.9);
		border-bottom: 1px solid rgba(122, 74, 43, 0.35);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.nav {
		align-items: center;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		margin: 0 auto;
		max-width: 1200px;
		padding: 0.6rem 1.25rem;
	}

	.brand {
		align-items: center;
		color: var(--color-black);
		display: inline-flex;
		font-family: 'MedievalSharp', serif;
		font-size: 1.4rem;
		gap: 0.6rem;
	}

	.brand img {
		height: 52px;
		object-fit: contain;
		width: 52px;
	}

	.nav-links {
		align-items: center;
		display: flex;
		gap: 1.6rem;
	}

	.nav-links a:hover {
		color: var(--color-earth-brown);
	}

	.nav-actions {
		align-items: center;
		display: flex;
		gap: 0.6rem;
	}

	.nav-cta {
		padding: 0.6rem 1.2rem;
	}

	.nav-toggle {
		display: none;
	}

	.mobile-nav {
		background: rgba(248, 243, 231, 0.97);
		display: none;
		gap: 0.2rem;
		padding: 0 1.25rem;
	}

	.mobile-nav a:not(.app-btn-cta) {
		border-bottom: 1px solid var(--color-line);
		font-family: 'MedievalSharp', serif;
		font-size: 1.25rem;
		padding: 0.7rem 0;
	}

	.mobile-nav .app-btn-cta {
		margin: 0.9rem 0 1.1rem;
	}

	.app-collapsible {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		pointer-events: none;
		transition: max-height 220ms ease, opacity 220ms ease;
	}

	.app-collapsible[data-open='true'] {
		max-height: 460px;
		opacity: 1;
		pointer-events: auto;
	}

	.hero {
		align-items: center;
		display: grid;
		gap: 2.5rem;
		grid-template-columns: 1fr 1.05fr;
		padding: 2.5rem 0 1.5rem;
	}

	h1 {
		font-size: clamp(2.3rem, 5vw, 4rem);
		line-height: 1.06;
		margin: 0.7rem 0 1rem;
	}

	h1 span {
		color: var(--color-terracotta);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.6rem;
	}

	.trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		list-style: none;
		margin: 1.6rem 0 0;
		padding: 0;
	}

	.trust li {
		align-items: center;
		display: inline-flex;
		font-size: 0.9rem;
		gap: 0.45rem;
	}

	.trust svg {
		color: var(--color-earth-brown);
		height: 18px;
		width: 18px;
	}

	.hero-visual {
		display: flex;
		justify-content: center;
	}

	.hero-logo {
		aspect-ratio: 1 / 1;
		height: auto;
		object-fit: contain;
		width: min(100%, 360px);
	}

	.collage {
		height: clamp(300px, 44vw, 520px);
		max-width: 560px;
		position: relative;
		width: 100%;
	}

	.slot {
		position: absolute;
	}

	.slot > a:first-child {
		height: 100%;
		width: 100%;
	}

	.slot-main {
		height: 86%;
		left: 0;
		top: 6%;
		width: 58%;
	}

	.slot-round {
		aspect-ratio: 1 / 1;
		right: 1%;
		top: 0;
		width: 39%;
	}

	.slot-small {
		bottom: 1%;
		height: 46%;
		right: 5%;
		width: 33%;
	}

	.price-tag {
		align-items: center;
		background: rgba(248, 243, 231, 0.95);
		border: 1px solid rgba(122, 74, 43, 0.3);
		border-radius: 999px;
		bottom: -0.8rem;
		box-shadow: 0 8px 18px rgba(47, 47, 47, 0.16);
		display: inline-flex;
		font-size: 0.8rem;
		gap: 0.4rem;
		left: 1rem;
		padding: 0.35rem 0.8rem;
		position: absolute;
		white-space: nowrap;
	}

	.slot-round .price-tag,
	.slot-small .price-tag {
		left: auto;
		right: 0;
	}

	.price-name {
		max-width: 7rem;
		overflow: hidden;
		text-overflow: ellipsis;
		text-transform: capitalize;
	}

	.price-tag strong {
		color: var(--color-terracotta);
	}

	.stamp {
		height: clamp(84px, 9vw, 112px);
		left: 53%;
		pointer-events: none;
		position: absolute;
		top: 44%;
		transform: translate(-50%, -50%);
		width: clamp(84px, 9vw, 112px);
	}

	.stamp svg {
		animation: spin 26s linear infinite;
		filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.25));
		height: 100%;
		width: 100%;
	}

	.stamp span {
		color: var(--color-mustard);
		display: grid;
		font-size: 1.5rem;
		inset: 0;
		place-items: center;
		position: absolute;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.section {
		margin-top: 4rem;
	}

	.section-head {
		align-items: end;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
	}

	.see-all {
		color: var(--color-earth-brown);
		font-weight: 600;
	}

	.pieces {
		display: grid;
		gap: 2rem 1.25rem;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: 1.5rem;
	}

	.piece {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.piece-media {
		aspect-ratio: 4 / 5;
		background: var(--color-sand);
		border-radius: 1.1rem;
		box-shadow: 0 14px 28px rgba(47, 47, 47, 0.12);
		display: block;
		overflow: hidden;
		position: relative;
	}

	.piece-media img {
		display: block;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s ease;
		width: 100%;
	}

	.piece:hover .piece-media img {
		transform: scale(1.06);
	}

	.badge {
		background: rgba(248, 243, 231, 0.94);
		border: 1px solid rgba(122, 74, 43, 0.35);
		border-radius: 999px;
		color: var(--color-earth-brown);
		font-size: 0.66rem;
		font-weight: 700;
		left: 0.6rem;
		letter-spacing: 0.08em;
		padding: 0.22rem 0.6rem;
		position: absolute;
		text-transform: uppercase;
		top: 0.6rem;
	}

	.piece-cta {
		background: rgba(17, 17, 17, 0.8);
		border-radius: 999px;
		bottom: 0.6rem;
		color: var(--color-cream);
		font-size: 0.85rem;
		font-weight: 600;
		left: 0.6rem;
		opacity: 0;
		padding: 0.6rem;
		position: absolute;
		right: 0.6rem;
		text-align: center;
		transform: translateY(110%);
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.piece:hover .piece-cta,
	.piece:focus-visible .piece-cta {
		opacity: 1;
		transform: translateY(0);
	}

	.piece-name {
		font-size: 0.95rem;
		margin-top: 0.4rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.piece-name::first-letter {
		text-transform: uppercase;
	}

	.piece-price {
		color: var(--color-black);
		font-size: 1.15rem;
		font-weight: 700;
	}

	.piece-price small {
		font-size: 0.75rem;
		font-weight: 400;
		margin-right: 0.3rem;
	}

	.center {
		display: flex;
		justify-content: center;
		margin-top: 2.25rem;
	}

	.benefits {
